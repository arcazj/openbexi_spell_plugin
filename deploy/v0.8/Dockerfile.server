# Private prelaunch-only v0.8 authority. NOT a production native runtime.
FROM python:3.13-slim@sha256:eb43ff125d8d58d7449dcba7d336c23bcac412f526d861db493b9994d8010280 AS wheel
WORKDIR /build
COPY server /build/server
RUN python -m pip wheel --no-deps --wheel-dir /wheels /build/server

FROM python:3.13-slim@sha256:eb43ff125d8d58d7449dcba7d336c23bcac412f526d861db493b9994d8010280
COPY --from=wheel /wheels /tmp/wheels
RUN python -m pip install --no-cache-dir --no-deps /tmp/wheels/*.whl \
    && rm -rf /tmp/wheels \
    && groupadd -g 65532 spell \
    && useradd -u 65532 -g 65532 -M -s /usr/sbin/nologin spell
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
USER 65532:65532
WORKDIR /state
ENTRYPOINT ["python", "-I", "-m", "openbexi_spell_server"]
LABEL org.opencontainers.image.version="0.8.0.dev44" \
      org.openbexi.release-scope="prelaunch-integration-only"
