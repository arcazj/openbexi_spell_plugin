# Private Gateway, Listener and Context service for the native qualification profile.
ARG SERVICE_INPUTS=wheel
FROM python:3.13-slim@sha256:eb43ff125d8d58d7449dcba7d336c23bcac412f526d861db493b9994d8010280 AS wheel
ARG WITH_BROWSER=0
ARG GIT_VERSION=1:2.47.3-0+deb13u1
WORKDIR /build
COPY server /build/server
RUN python -m pip wheel --no-deps --wheel-dir /wheels /build/server
RUN case "$WITH_BROWSER" in \
      0) ;; \
      1) python -m pip download --require-hashes --no-deps --only-binary=:all: -d /wheels -r /build/server/requirements-browser.lock ;; \
      *) exit 2 ;; \
    esac
RUN sed -i 's|http://deb.debian.org|https://deb.debian.org|g' /etc/apt/sources.list.d/debian.sources \
    && apt-get update \
    && apt-get --download-only --no-install-recommends -y install "git=${GIT_VERSION}" \
    && mkdir /debs && cp /var/cache/apt/archives/*.deb /debs/

FROM scratch AS staged
COPY wheels/ /wheels/
COPY debs/ /debs/

FROM ${SERVICE_INPUTS} AS selected

FROM python:3.13-slim@sha256:eb43ff125d8d58d7449dcba7d336c23bcac412f526d861db493b9994d8010280
COPY --from=selected /wheels /tmp/wheels
COPY --from=selected /debs /tmp/debs
RUN DEBIAN_FRONTEND=noninteractive apt-get -y --no-install-recommends install /tmp/debs/*.deb \
    && git --version \
    && python -m pip install --no-cache-dir --no-index --no-deps /tmp/wheels/*.whl \
    && python -m pip check \
    && rm -rf /tmp/debs /tmp/wheels /var/lib/apt/lists/* \
    && groupadd -g 65532 spell \
    && useradd -u 65532 -g 65532 -M -s /usr/sbin/nologin spell
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
USER 65532:65532
WORKDIR /state
ENTRYPOINT ["python", "-I", "-m", "openbexi_spell_server"]
LABEL org.opencontainers.image.version="0.8.0" \
      org.openbexi.release-scope="qualification-candidate"
