<idea-plugin require-restart="true">
  <id>org.openbexi.spell</id>
  <name>OpenBEXI SPELL</name>
  <version>0.3.1-workspace.1</version>
  <vendor>OpenBEXI</vendor>
  <description><![CDATA[Run and debug explicit-import SPELL procedures through the separately installed OpenBEXI SPELL host runtime. Requires CPython 3.13, the host wheel and the native Docker image.]]></description>
  <idea-version since-build="261" until-build="262.*"/>
  <depends>com.intellij.modules.platform</depends>
  <depends>com.intellij.modules.xdebugger</depends>
  <extensions defaultExtensionNs="com.intellij">
    <projectService serviceImplementation="org.openbexi.spell.SpellSettings"/>
    <projectService serviceImplementation="org.openbexi.spell.SpellWorkspace"/>
    <additionalLibraryRootsProvider implementation="org.openbexi.spell.SpellEditorLibrary"/>
    <projectConfigurable id="org.openbexi.spell.settings" displayName="SPELL Runtime" instance="org.openbexi.spell.SpellConfigurable"/>
    <toolWindow id="SPELL" anchor="bottom" factoryClass="org.openbexi.spell.SpellToolWindow"/>
    <xdebugger.breakpointType implementation="org.openbexi.spell.SpellBreakpointType"/>
  </extensions>
  <actions>
    <group id="OpenBEXI.Spell" text="SPELL" popup="true">
      <add-to-group group-id="ToolsMenu" anchor="last"/>
      <group id="OpenBEXI.Spell.Procedures" text="Procedures" popup="true">
        <action id="OpenBEXI.Spell.Run" class="org.openbexi.spell.SpellRunAction" text="Run File with SPELL" icon="AllIcons.Actions.Execute"/>
        <action id="OpenBEXI.Spell.Debug" class="org.openbexi.spell.SpellDebugAction" text="Debug File with SPELL" icon="AllIcons.Actions.StartDebugger"/>
      </group>
      <group id="OpenBEXI.Spell.Execution" text="Execution" popup="true">
        <action id="OpenBEXI.Spell.Pause" class="org.openbexi.spell.SpellWorkspaceActions$Pause" text="Pause"/>
        <action id="OpenBEXI.Spell.Continue" class="org.openbexi.spell.SpellWorkspaceActions$Continue" text="Continue"/>
        <action id="OpenBEXI.Spell.Step" class="org.openbexi.spell.SpellWorkspaceActions$Step" text="Step Over"/>
        <action id="OpenBEXI.Spell.Stop" class="org.openbexi.spell.SpellWorkspaceActions$Stop" text="Abort Procedure"/>
      </group>
      <action id="OpenBEXI.Spell.Workspace" class="org.openbexi.spell.SpellWorkspaceActions$Open" text="Procedure Workspace"/>
      <separator/>
      <action id="OpenBEXI.Spell.SyncEditor" class="org.openbexi.spell.SpellEditorSyncAction" text="Sync SPELL Editor Definitions"/>
      <action id="OpenBEXI.Spell.Settings" class="org.openbexi.spell.SpellSettingsAction" text="SPELL Runtime Settings"/>
    </group>
  </actions>
</idea-plugin>
