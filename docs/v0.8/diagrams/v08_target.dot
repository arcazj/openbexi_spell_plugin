digraph v08 {
  graph [rankdir=LR, bgcolor="white", fontname="Arial", fontsize=22, pad=.35, nodesep=.4, ranksep=.75, dpi=150,
    labelloc=t, label="OpenBEXI SPELL v0.8 — PROPOSED, approval pending\nNo separate Management Service; Context owns all execution management"];
  node [shape=box, style="rounded,filled", fillcolor="#f1f5fb", color="#718096", fontname="Arial", fontsize=15, margin=".2,.15"];
  edge [color="#52637b", fontname="Arial", fontsize=12];
  u1 [label="U1 controller\nOwns A1, A2 and B1"];
  u2 [label="U2 / U3 / observers\nRead-only; may request control"];
  git [label="Development workspaces\nClean Git SHA + inventory\nExpected-base conflict detection"];
  edgeproxy [label="TLS edge\nOnly published HTTPS port\nRegistered client identity"];
  listener [label="Listener process\nAuthentication • sessions\nContext discovery • routing\nHTTPS REST + WSS replay"];
  subgraph cluster_a {
    label="Context A — separate authority process / container"; color="#83a9c4"; fontname="Arial"; fontsize=17;
    ca [label="Context A authority\nProcedure reservations + supervisor\nPer-execution owner / epoch / claims\nBlackboard • fanout • driver binding"];
    sa [shape=cylinder, label="Context A SQLite volume\nAtomic intent / owner / audit"];
    a1 [label="Worker A1 / Executor subprocess\nCPython 3.13 + qualified SPELL\nPrivate native helpers"];
    a2 [label="Worker A2 / Executor subprocess\nSame isolation contract"];
    ca -> sa [dir=both, label="Single-writer transactions"];
    ca -> a1 [dir=both, label="Private versioned mTLS RPC\nGeneration / cancellation"];
    ca -> a2 [dir=both, label="Private versioned mTLS RPC"];
  }
  subgraph cluster_b {
    label="Context B — independent authority process / container"; color="#83a9c4"; fontname="Arial"; fontsize=17;
    cb [label="Context B authority\nIndependent owners / claims\nBlackboard / driver binding"];
    sb [shape=cylinder, label="Context B SQLite volume"];
    b1 [label="Worker B1 / Executor subprocess\nIsolated runtime and source"];
    cb -> sb [dir=both, label="Durable state"];
    cb -> b1 [dir=both, label="Private versioned mTLS RPC"];
  }
  adapters [label="Context-bound Driver adapters\nOriginal facade contract\nLive per-write epoch/fence check\nIntent / receipt; no uncertain replay", fillcolor="#e6f1e9"];
  dss [label="Independent GENERIC DSS process\nConfigured HTTP + binary TC TCP\nOptional Kafka TM", fillcolor="#e6f1e9"];
  gcs [label="Vendor GCS / spacecraft\nUNKNOWN; disabled until validated", style="rounded,dashed", fillcolor="white"];
  u1 -> edgeproxy [label="Control A1 / A2 / B1"];
  u2 -> edgeproxy [label="Observe + request A2"];
  git -> edgeproxy [label="Scoped Development"];
  edgeproxy -> listener [dir=both, label="Authenticated private link"];
  listener -> ca [dir=both, label="mTLS + scoped identity\nContext authorizes every mutation"];
  listener -> cb [dir=both, label="mTLS versioned JSON RPC"];
  git -> a1 [style=dashed, label="Immutable read-only snapshot"];
  a1 -> adapters [label="Private relay via Context"];
  a2 -> adapters [label="Private relay via Context"];
  b1 -> adapters [label="Private relay via Context"];
  adapters -> dss [dir=both, label="Verified v0.7 transport contract\nRequalification required"];
  adapters -> gcs [style=dashed, label="Optional, site-qualified"];
  consent [shape=note, fillcolor="#fff1d9", label="Transfer A2 only:\nU2 requests → U1 accepts\nContext CAS owner + epoch\nU1 retains A1 and B1\nNo disconnect-based takeover"];
  ca -> consent [style=dashed, label="Proposed invariant"];
  deployment [shape=note, fillcolor="#fff1d9", label="Compose: static bounded worker pool\nK8s: one Job/Pod per execution\nNo Docker socket in Listener/Context\nAll v0.8 acceptance gates NOT RUN"];
  cb -> deployment [style=dashed];
}
